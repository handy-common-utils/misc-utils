{
  "include": ["src"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist",

    "lib": ["es2022"],
    "target": "es2017",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
